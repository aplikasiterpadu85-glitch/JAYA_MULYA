{
  "name": "JAYA MULYA 3D",
  "short_name": "JayaMulya",
  "id": "JAYA_MULYA",
  "description": "Aplikasi pencatat keuangan dan laporan by ayik",
  "start_url": "/JAYA_MULYA/index.html",
  "scope": "/JAYA_MULYA/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "browser"
  ],
  "orientation": "any",
  "background_color": "#eff7f7",
  "theme_color": "#ffffff",
  "dir": "ltr",
  "lang": "id",
  "categories": [
    "business",
    "finance",
    "utilities"
  ],
  "icons": [
    {
      "src": "./launchericon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./launchericon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Laporan Keuangan",
      "short_name": "Laporan",
      "description": "Buka langsung menu laporan",
      "url": "/JAYA_MULYA/index.html#laporan",
      "icons": [
        {
          "src": "./launchericon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Tambah Item / Transaksi",
      "short_name": "Tambah",
      "description": "Tambah transaksi atau produk baru",
      "url": "/JAYA_MULYA/index.html#item",
      "icons": [
        {
          "src": "./launchericon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/JAYA_MULYA/index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+jayamulya",
      "url": "/JAYA_MULYA/index.html?query=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "widgets": [
    {
      "name": "Ringkasan JayaMulya",
      "short_name": "Ringkasan",
      "description": "Widget laporan singkat JayaMulya",
      "tag": "jayamulya-widget",
      "template": "widget-template",
      "ms_ac_template": "widget.json",
      "data": "widget-data.json",
      "type": "text/html",
      "screenshots": [
        {
          "src": "./launchericon-512x512.png",
          "sizes": "512x512",
          "label": "Tampilan Widget"
        }
      ]
    }
  ],
  "note_taking": {
    "new_note_url": "/JAYA_MULYA/index.html#note"
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/JAYA_MULYA/index.html",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"]
      }
    }
  ]
}
